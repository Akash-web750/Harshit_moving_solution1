{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "harshit-moving-solutions-app": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/harshit-moving-solutions-app",
      "sourceRoot": "projects/harshit-moving-solutions-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/harshit-moving-solutions-app/browser",
            "index": "projects/harshit-moving-solutions-app/src/index.html",
            "browser": "projects/harshit-moving-solutions-app/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/harshit-moving-solutions-app/tsconfig.app.json",
            "assets": [
              {
                "glob": "favicon.ico",
                "input": "projects/harshit-moving-solutions-app/src",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "projects/harshit-moving-solutions-app/src/assets",
                "output": "/assets/"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "projects/harshit-moving-solutions-app/src/styles.css"
            ],
            "scripts": [
              "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "harshit-moving-solutions-app:build:production"
            },
            "development": {
              "buildTarget": "harshit-moving-solutions-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "harshit-moving-solutions-app:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/harshit-moving-solutions-app/tsconfig.spec.json",
            "assets": [
              "projects/harshit-moving-solutions-app/src/favicon.ico",
              "projects/harshit-moving-solutions-app/src/assets"
            ],
            "styles": [
              "projects/harshit-moving-solutions-app/src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "35c6ddd4-6afe-416c-9f7f-c310efb170fc"
  }
}
